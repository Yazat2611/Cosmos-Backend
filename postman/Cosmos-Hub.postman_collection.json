{
  "info": {
    "name": "Cosmos Hub",
    "description": "Tests for the Cosmos Hub backend, plus direct checks against the NASA APIs it uses.\n\nRun the 'Cosmos Hub backend' folder in order with the Collection Runner: it fetches asteroids twice and confirms the row count doesn't grow (duplicate fix), checks the asteroid full name (fullname fix), and validates Earth event coordinates (polygon fix).\n\nSet the baseUrl variable if your server isn't on localhost:8080.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "designation", "value": "433" }
  ],
  "item": [
    {
      "name": "Cosmos Hub backend",
      "item": [
        {
          "name": "1. Fetch asteroids from NASA (first run)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/asteroids/fetch", "host": ["{{baseUrl}}"], "path": ["api", "asteroids", "fetch"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));"
            ]}
          }]
        },
        {
          "name": "2. Get upcoming asteroids (record count)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/asteroids/all", "host": ["{{baseUrl}}"], "path": ["api", "asteroids", "all"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const rows = pm.response.json();",
              "pm.collectionVariables.set('asteroidCount', rows.length);",
              "console.log('Asteroid rows after first fetch:', rows.length);",
              "",
              "// Dates may come back as '2026-11-03T04:20:00' or [2026,11,3,4,20]; normalise to 'YYYY-MM-DDTHH:mm'",
              "const toKey = d => Array.isArray(d)",
              "  ? `${d[0]}-${String(d[1]).padStart(2,'0')}-${String(d[2]).padStart(2,'0')}T${String(d[3]||0).padStart(2,'0')}:${String(d[4]||0).padStart(2,'0')}`",
              "  : String(d).slice(0, 16);",
              "",
              "pm.test('Only upcoming approaches are returned', () => {",
              "  const now = new Date().toISOString().slice(0, 16);",
              "  rows.forEach(r => pm.expect(toKey(r.closeApproachDate) >= now, r.designation).to.be.true);",
              "});",
              "",
              "pm.test('Sorted by approach date, earliest first', () => {",
              "  for (let i = 1; i < rows.length; i++) {",
              "    pm.expect(toKey(rows[i].closeApproachDate) >= toKey(rows[i - 1].closeApproachDate)).to.be.true;",
              "  }",
              "});",
              "",
              "pm.test('No duplicate approaches', () => {",
              "  const keys = rows.map(r => r.designation + '|' + toKey(r.closeApproachDate));",
              "  pm.expect(new Set(keys).size).to.eql(keys.length);",
              "});"
            ]}
          }]
        },
        {
          "name": "3. Fetch asteroids again (second run)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/asteroids/fetch", "host": ["{{baseUrl}}"], "path": ["api", "asteroids", "fetch"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));"
            ]}
          }]
        },
        {
          "name": "4. Get upcoming asteroids (count unchanged)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/asteroids/all", "host": ["{{baseUrl}}"], "path": ["api", "asteroids", "all"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const rows = pm.response.json();",
              "const before = Number(pm.collectionVariables.get('asteroidCount'));",
              "console.log('Asteroid rows before/after second fetch:', before, rows.length);",
              "pm.test('Second fetch did not add duplicate rows', () => {",
              "  pm.expect(rows.length).to.be.at.most(before);",
              "});"
            ]}
          }]
        },
        {
          "name": "5. Get asteroid details (SBDB)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/asteroids/details/{{designation}}", "host": ["{{baseUrl}}"], "path": ["api", "asteroids", "details", "{{designation}}"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Full name is filled in', () => {",
              "  pm.expect(body.object.fullName).to.be.a('string').and.not.empty;",
              "});",
              "pm.test('Orbit elements are present', () => {",
              "  pm.expect(body.orbit.elements).to.be.an('array').that.is.not.empty;",
              "});"
            ]}
          }]
        },
        {
          "name": "6. Get Earth events (EONET)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/earth-events", "host": ["{{baseUrl}}"], "path": ["api", "earth-events"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const events = pm.response.json();",
              "console.log('Earth events:', events.length);",
              "pm.test('Every geometry has valid coordinates (incl. polygons)', () => {",
              "  events.forEach(e => (e.geometries || []).forEach(g => {",
              "    pm.expect(g.longitude, e.title).to.be.within(-180, 180);",
              "    pm.expect(g.latitude, e.title).to.be.within(-90, 90);",
              "    pm.expect(g.longitude === 0 && g.latitude === 0, e.title + ' has 0,0').to.be.false;",
              "  }));",
              "});"
            ]}
          }]
        }
      ]
    },
    {
      "name": "NASA upstream checks",
      "description": "Direct calls to the NASA APIs, to confirm each one is up. None need an API key.",
      "item": [
        {
          "name": "JPL Close Approach (CAD)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "https://ssd-api.jpl.nasa.gov/cad.api?dist-max=0.5",
              "protocol": "https", "host": ["ssd-api", "jpl", "nasa", "gov"], "path": ["cad.api"],
              "query": [{ "key": "dist-max", "value": "0.5" }]
            }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "console.log('CAD version:', body.signature && body.signature.version);",
              "pm.test('Field order still matches', () => {",
              "  pm.expect(body.fields).to.include.members(['des','orbit_id','jd','cd','dist','dist_min','dist_max','v_rel','v_inf','t_sigma_f','h']);",
              "});"
            ]}
          }]
        },
        {
          "name": "JPL Small-Body Database (SBDB)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "https://ssd-api.jpl.nasa.gov/sbdb.api?sstr={{designation}}",
              "protocol": "https", "host": ["ssd-api", "jpl", "nasa", "gov"], "path": ["sbdb.api"],
              "query": [{ "key": "sstr", "value": "{{designation}}" }]
            }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Returns object.fullname', () => pm.expect(pm.response.json().object.fullname).to.be.a('string'));"
            ]}
          }]
        },
        {
          "name": "EONET v3 open events",
          "request": {
            "method": "GET",
            "url": {
              "raw": "https://eonet.gsfc.nasa.gov/api/v3/events?status=open&limit=10",
              "protocol": "https", "host": ["eonet", "gsfc", "nasa", "gov"], "path": ["api", "v3", "events"],
              "query": [{ "key": "status", "value": "open" }, { "key": "limit", "value": "10" }]
            }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Has events array', () => pm.expect(pm.response.json().events).to.be.an('array'));"
            ]}
          }]
        },
        {
          "name": "DONKI solar flares (new CCMC host)",
          "request": {
            "method": "GET",
            "description": "New DONKI host since 30 Sep 2026. Date range is capped at 60 days.",
            "url": {
              "raw": "https://ccmc.gsfc.nasa.gov/DONKI-API/get/FLR",
              "protocol": "https", "host": ["ccmc", "gsfc", "nasa", "gov"], "path": ["DONKI-API", "get", "FLR"]
            }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Returns JSON, not a web page', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('json'));"
            ]}
          }]
        },
        {
          "name": "APOD latest (science.nasa.gov)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "https://science.nasa.gov/wp-json/wp/v2/apod-basic?per_page=1",
              "protocol": "https", "host": ["science", "nasa", "gov"], "path": ["wp-json", "wp", "v2", "apod-basic"],
              "query": [{ "key": "per_page", "value": "1" }]
            }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));"
            ]}
          }]
        }
      ]
    }
  ]
}
